# GuardianPay AI Environment Variables
# VIT Hackathon - Team Klyrova

# Google Gemini API Key for scam message analysis
GEMINI_API_KEY=

# FastAPI Backend Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Database Configuration (SQLite)
SQLITE_DB_PATH=guardianpay.sqlite
DATABASE_URL=sqlite:///./guardianpay.sqlite

# Frontend API Base URL (Vercel deployment pointing to Render backend)
VITE_API_URL=
